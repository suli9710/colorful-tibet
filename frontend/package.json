{
    "name": "colorful-tibet-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "check": "npm run typecheck && npm run test -- --run && npm run build",
        "build": "vite build",
        "test": "vitest",
        "typecheck": "vue-tsc --noEmit",
        "generate:api-types": "openapi-typescript http://localhost:8080/v3/api-docs -o src/api/generated/schema.d.ts",
        "preview": "vite preview",
        "postinstall": "node scripts/patch-redocly-minimatch.mjs"
    },
    "dependencies": {
        "@fingerprintjs/fingerprintjs": "^4.5.1",
        "axios": "^1.21.0",
        "dompurify": "^3.4.17",
        "echarts": "^6.1.0",
        "leaflet": "^1.9.4",
        "lucide-vue-next": "^0.344.0",
        "marked": "^17.0.1",
        "motion-v": "^2.2.1",
        "pinia": "^2.1.7",
        "vue": "^3.5.44",
        "vue-i18n": "^11.4.16",
        "vue-router": "^4.3.0"
    },
    "devDependencies": {
        "@intlify/unplugin-vue-i18n": "^11.2.8",
        "@types/leaflet": "^1.9.21",
        "@types/node": "^22.19.20",
        "@vitejs/plugin-vue": "^6.0.7",
        "autoprefixer": "^10.4.18",
        "esbuild": "^0.28.1",
        "jsdom": "^29.1.1",
        "openapi-typescript": "^7.13.0",
        "postcss": "^8.4.35",
        "tailwindcss": "^3.4.1",
        "terser": "^5.36.0",
        "typescript": "^5.2.2",
        "vite": "^8.3.5",
        "vitest": "^4.1.12",
        "vue-tsc": "^3.2.8"
    },
    "overrides": {
        "esbuild": "$esbuild",
        "@typescript-eslint/typescript-estree": {
            "minimatch": "11.0.1"
        },
        "@redocly/openapi-core": {
            "minimatch": "11.0.1"
        }
    }
}
