# Runtime profile
SPRING_PROFILES_ACTIVE=local
VITE_API_BASE_URL=/api

# Database
# Replace all change-me values with deployment-specific random secrets before running compose.
MYSQL_DATABASE=colorful_tibet
MYSQL_USERNAME=colorful_tibet_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
DB_NAME=tibet_tourism
DB_USERNAME=tibet_user
DB_PASSWORD=change-me
DB_HOST=mysql
DB_PORT=3306
# Bundled Docker MySQL does not enable TLS by default, so compose uses DISABLED.
# For an external database, set DB_SSL_MODE=VERIFY_IDENTITY and provide an
# explicit CA/truststore through DB_JDBC_EXTRA_PARAMS, for example:
# &trustCertificateKeyStoreUrl=file:/run/secrets/mysql-truststore.p12&trustCertificateKeyStorePassword=change-me&trustCertificateKeyStoreType=PKCS12
DB_SSL_MODE=DISABLED
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false
DB_JDBC_EXTRA_PARAMS=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DATABASE=0

# Backend secrets
JWT_SECRET=replace-with-at-least-64-random-characters
ADMIN_ENCRYPTION_KEY=replace-with-at-least-64-random-characters
CSRF_SIGNING_SECRET=replace-with-different-at-least-64-random-characters
PII_KEYS=v1:replace-with-base64-32-byte-key
PII_ACTIVE_KID=v1
PII_ENCRYPTION_KEY=replace-with-at-least-64-random-characters
PAYMENT_CALLBACK_SECRET=replace-with-at-least-64-random-characters
REQUIRE_STRONG_SECRETS=true

# AI providers
# Required for real AI route generation. Leave blank only if local fallback routes are acceptable.
DOUBAO_API_KEY=
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses
DOUBAO_STREAM_API_URL=
DOUBAO_MODEL=ep-20260516173036-4dpgm
ARK_API_KEY=
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses
ARK_STREAM_API_URL=
ARK_MODEL=ep-20260516173036-4dpgm
AI_MODEL=ep-20260516173036-4dpgm
AI_STREAM_TIMEOUT=180
AI_DAILY_QUOTA_PER_USER=20

# Security and anti-abuse
COOKIE_SECURE=true
SERVER_FORWARD_HEADERS_STRATEGY=none
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,127.0.0.1/32
CORS_ALLOWED_ORIGINS=https://example.com
ANTIBOT_ENABLED=true
RECAPTCHA_ENABLED=false
VITE_RECAPTCHA_ENABLED=false
VITE_RECAPTCHA_MODE=v2
RECAPTCHA_SITE_KEY=
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
FINGERPRINT_ENABLED=true
BEHAVIOR_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=12
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_REQUESTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_AI_REQUESTS=6
RATE_LIMIT_AI_WINDOW_SECONDS=600

# Third-party integrations
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
IP_LOCATION_URL_TEMPLATE=https://ipapi.co/{ip}/json/
SCRAPLING_SERVICE_URL=http://scrapling:8000
SCRAPLING_SERVICE_TIMEOUT=30
SCRAPLING_HEALTH_ENABLED=true
SCRAPLING_MODE=stealth
SCRAPLING_TIMEOUT_SECONDS=30
SCRAPLING_RETRIES=2
SCRAPLING_MAX_SOURCES=4
SCRAPLING_SEARCH_PROVIDERS=baidu,bing
SCRAPLING_ALLOWED_DOMAINS=
SCRAPLING_PROXY_URL=
SCRAPLING_SOLVE_CLOUDFLARE=false

# Frontend/Nginx production
NGINX_SERVER_NAME=example.com www.example.com
NGINX_CERT_DOMAIN=example.com
FRONTEND_HOST_PORT=80
BACKEND_HOST_PORT=8080

# Monitoring
ALERTMANAGER_WEBHOOK_URL=https://example.com/alerts
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
TRACING_SAMPLING_PROBABILITY=0.1

# Content/admin
PUBLIC_DOCS_ENABLED=false
SEED_CONTENT_ENABLED=false
SUPER_ADMIN_USERNAME=lzh
SUPER_ADMIN_TOTP_SECRET=replace-with-base32-totp-secret
PAYMENT_MOCK_CALLBACK_ENABLED=false
RECOMMENDATION_ITEM_SIMILARITY_PRELOAD_ON_STARTUP=false
APP_RECOMMENDATION_ITEM_SIMILARITY_MAX_SPOTS=2000
APP_RECOMMENDATION_ITEM_SIMILARITY_MAX_HISTORIES=50000
APP_PRICE_UPDATE_MAX_BATCH_SPOTS=1000
